(export (version "E")
  (design
    (source "fuzz_face.kicad_sch")
    (tool "Eeschema 8.0"))
  (components
    (comp (ref "C1") (value "2.2u")
      (libsource (lib "Device") (part "C_Polarized") (description "Polarized capacitor")))
    (comp (ref "C2") (value "10n")
      (libsource (lib "Device") (part "C") (description "Unpolarized capacitor")))
    (comp (ref "CFZ") (value "20u")
      (libsource (lib "Device") (part "C_Polarized") (description "Polarized capacitor")))
    (comp (ref "Q1") (value "AC128")
      (libsource (lib "Transistor_BJT") (part "Q_PNP_EBC") (description "PNP transistor, emitter/base/collector"))
      (property (name "Sim.Device") (value "PNP"))
      (property (name "Sim.Type") (value "GUMMELPOON"))
      (property (name "Sim.Library") (value "models.lib"))
      (property (name "Sim.Name") (value "AC128"))
      (property (name "Sim.Pins") (value "1=E 2=B 3=C")))
    (comp (ref "Q2") (value "AC128")
      (libsource (lib "Transistor_BJT") (part "Q_PNP_EBC") (description "PNP transistor, emitter/base/collector"))
      (property (name "Sim.Device") (value "PNP"))
      (property (name "Sim.Library") (value "models.lib"))
      (property (name "Sim.Name") (value "AC128"))
      (property (name "Sim.Pins") (value "1=E 2=B 3=C")))
    (comp (ref "R1") (value "33k"))
    (comp (ref "R2") (value "470"))
    (comp (ref "R3") (value "8k2"))
    (comp (ref "RFB") (value "100k"))
    (comp (ref "RFZ") (value "1k"))
    (comp (ref "RG") (value "1k"))
    (comp (ref "RV") (value "500k")
      (property (name "Sim.Device") (value "R"))
      (property (name "Sim.Params") (value "r=500k")))
    (comp (ref "VEE") (value "-9")
      (libsource (lib "Simulation_SPICE") (part "VDC") (description "Voltage source, DC"))
      (property (name "Sim.Device") (value "V"))
      (property (name "Sim.Type") (value "DC"))
      (property (name "Sim.Pins") (value "1=+ 2=-")))
    (comp (ref "VIN") (value "SIN")
      (libsource (lib "Simulation_SPICE") (part "VSIN") (description "Voltage source, sinusoidal"))
      (property (name "Sim.Device") (value "V"))
      (property (name "Sim.Type") (value "SIN"))
      (property (name "Sim.Params") (value "dc=0 ampl=0.2 f=220"))
      (property (name "Sim.Pins") (value "1=+ 2=-"))))
  (nets
    (net (code "1") (name "GND")
      (node (ref "CFZ") (pin "2"))
      (node (ref "Q1") (pin "1") (pinfunction "E"))
      (node (ref "RFZ") (pin "2"))
      (node (ref "RV") (pin "2"))
      (node (ref "VEE") (pin "2"))
      (node (ref "VIN") (pin "2")))
    (net (code "2") (name "/in")
      (node (ref "RG") (pin "1"))
      (node (ref "VIN") (pin "1")))
    (net (code "3") (name "/i")
      (node (ref "C1") (pin "1"))
      (node (ref "RG") (pin "2")))
    (net (code "4") (name "/b1")
      (node (ref "C1") (pin "2"))
      (node (ref "Q1") (pin "2") (pinfunction "B"))
      (node (ref "RFB") (pin "2")))
    (net (code "5") (name "/c1")
      (node (ref "Q1") (pin "3") (pinfunction "C"))
      (node (ref "Q2") (pin "2") (pinfunction "B"))
      (node (ref "R1") (pin "1")))
    (net (code "6") (name "/vee")
      (node (ref "R1") (pin "2"))
      (node (ref "R3") (pin "2"))
      (node (ref "VEE") (pin "1")))
    (net (code "7") (name "/e2")
      (node (ref "CFZ") (pin "1"))
      (node (ref "Q2") (pin "1") (pinfunction "E"))
      (node (ref "RFB") (pin "1"))
      (node (ref "RFZ") (pin "1")))
    (net (code "8") (name "/c2")
      (node (ref "Q2") (pin "3") (pinfunction "C"))
      (node (ref "R2") (pin "1")))
    (net (code "9") (name "/o")
      (node (ref "C2") (pin "1"))
      (node (ref "R2") (pin "2"))
      (node (ref "R3") (pin "1")))
    (net (code "10") (name "/out")
      (node (ref "C2") (pin "2"))
      (node (ref "RV") (pin "1")))))
