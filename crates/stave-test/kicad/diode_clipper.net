(export (version "E")
  (design
    (source "diode_clipper.kicad_sch")
    (tool "Eeschema 8.0")
    (sheet (number "1") (name "/") (tstamps "/")
      (title_block (title "Diode clipper") (company) (rev) (date) (source "diode_clipper.kicad_sch"))))
  (components
    (comp (ref "V1")
      (value "SIN")
      (libsource (lib "Simulation_SPICE") (part "VSIN") (description "Voltage source, sinusoidal"))
      (property (name "Sim.Device") (value "V"))
      (property (name "Sim.Type") (value "SIN"))
      (property (name "Sim.Params") (value "dc=0 ampl=1 f=1k"))
      (property (name "Sim.Pins") (value "1=+ 2=-"))
      (property (name "Sheetname") (value ""))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "6b0f2c1e-0001-4000-8000-000000000001"))
    (comp (ref "R1")
      (value "2.2k")
      (footprint "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal")
      (libsource (lib "Device") (part "R") (description "Resistor"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "6b0f2c1e-0001-4000-8000-000000000002"))
    (comp (ref "C1")
      (value "10n")
      (libsource (lib "Device") (part "C") (description "Unpolarized capacitor"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "6b0f2c1e-0001-4000-8000-000000000003"))
    (comp (ref "D1")
      (value "1N4148")
      (libsource (lib "Diode") (part "1N4148") (description "100V 0.15A standard switching diode"))
      (property (name "Sim.Device") (value "D"))
      (property (name "Sim.Params") (value "is=2.52n n=1.752 rs=0.568 cjo=4p m=0.4 tt=20n bv=100"))
      (property (name "Sim.Pins") (value "1=K 2=A"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "6b0f2c1e-0001-4000-8000-000000000004"))
    (comp (ref "D2")
      (value "1N4148")
      (libsource (lib "Diode") (part "1N4148") (description "100V 0.15A standard switching diode"))
      (property (name "Sim.Device") (value "D"))
      (property (name "Sim.Library") (value "${KIPRJMOD}/models/models.lib"))
      (property (name "Sim.Name") (value "D1N4148"))
      (property (name "Sim.Pins") (value "1=K 2=A"))
      (sheetpath (names "/") (tstamps "/"))
      (tstamps "6b0f2c1e-0001-4000-8000-000000000005")))
  (libparts
    (libpart (lib "Device") (part "R")
      (pins
        (pin (num "1") (name "") (type "passive"))
        (pin (num "2") (name "") (type "passive")))))
  (libraries
    (library (logical "Device") (uri "Device.kicad_sym")))
  (nets
    (net (code "1") (name "/in")
      (node (ref "V1") (pin "1") (pinfunction "+") (pintype "passive"))
      (node (ref "R1") (pin "1") (pintype "passive")))
    (net (code "2") (name "/out")
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "C1") (pin "1") (pintype "passive"))
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive"))
      (node (ref "D2") (pin "1") (pinfunction "K") (pintype "passive")))
    (net (code "3") (name "GND")
      (node (ref "C1") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
      (node (ref "D2") (pin "2") (pinfunction "A") (pintype "passive"))
      (node (ref "V1") (pin "2") (pinfunction "-") (pintype "passive")))))
