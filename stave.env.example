# Per-machine configuration for stave's scripts. Copy what you need to
#   ~/.config/stave/env        (this machine), or
#   .stave/local.env           (this checkout; gitignored)
# and set the values. Every key is optional; the environment overrides both
# files. See the guide: How-to → Local configuration.

# Build hosts for scripts/offload.sh (any ssh destination with rustup and
# cargo-nextest). A Linux host covers the whole workspace's build and tests;
# a macOS host is needed for the Cocoa crates and macOS-only checks.
# STAVE_LINUX_HOST=my-linux-box
# STAVE_MACOS_HOST=my-mac

# Hosts where rsync misbehaves (e.g. a container that refuses signals
# between processes): offload.sh sends a tarball to these instead
# (space-separated).
# STAVE_TAR_HOSTS="my-linux-box"

# `offload.sh auto` takes a free slot on one of these, the least loaded per
# core first (`local` = this machine), and queues while none is free.
# `host:N` gives a host N build slots.
# STAVE_AUTO_HOSTS="my-linux-box:2 my-mac local"
# `local` leaves the pool while this disk has less free space than this (GB).
# STAVE_AUTO_MIN_FREE_GB=30

# Build slots per host: how many offload jobs it runs at once, each with
# cores / slots of its cores. Default: a quarter of the host's cores (6 or 8
# cores: 2); `local`: 1. HOST:N on the command line or in STAVE_AUTO_HOSTS
# overrides these.
# STAVE_LINUX_SLOTS=2
# STAVE_MACOS_SLOTS=2
# STAVE_LOCAL_SLOTS=1
# STAVE_OFFLOAD_CLASS=long jobs (ngspice batches, fuzzing, kani, datasheet
# fits) run one per host at nice 19; on a build host they get their own
# slot (1, the default) instead of taking a build slot (0).
# STAVE_OFFLOAD_LONG_SLOT=1
# Stop any offload job after this long (seconds, or 30m, 2h); unset, a job
# runs as long as it needs. Usually set per command, not here.
# STAVE_OFFLOAD_TIMEOUT=2h
# A command that gets one JSON line on stdin when a job starts and ends
# ({kind: job.started|job.finished, title, host, slot, outcome, at}),
# e.g. a dashboard's ingest CLI.
# STAVE_OFFLOAD_EVENTS="my-dashboard ingest"

# The machine whose numbers are committed to crates/stave-dsp/datasheet.json,
# and how the Cost page names it (describe the hardware, not the host).
# STAVE_REFERENCE_HOST=my-mac
# STAVE_REFERENCE_NAME="Apple M1, 8 cores"

# Reference program material (DSP.md R22) and hardware captures (R8). Never
# committed; tests that need them skip, saying so, when unset or absent.
# STAVE_SAMPLE_LIBRARY="/path/to/Sample Library"
# The corpus lock (scripts/corpus.sh lock): each corpus pick's checksum, so a
# run names exactly what it played. Default ~/.config/stave/corpus.lock.
# STAVE_CORPUS_LOCK="/path/to/corpus.lock"
# STAVE_CAPTURES="/path/to/captures"

# Shipping (scripts/package.sh; the guide: How-to → Ship your plugin).
# The macOS codesigning identity: its full name as `security find-identity
# -v -p codesigning` prints it, or its SHA-1. Unset, bundles stay ad-hoc
# signed (this machine only).
# STAVE_SIGN_IDENTITY="Developer ID Application: <Your Name> (<TEAM_ID>)"
# The notarytool keychain profile, made once with
#   xcrun notarytool store-credentials <profile> --apple-id <email> --team-id <TEAM_ID>
# (package.sh prints the full command when it is missing; it never sees
# the password).
# STAVE_NOTARY_PROFILE=<profile>
# A "Developer ID Installer: …" identity, to build a .pkg beside the .dmg.
# STAVE_INSTALLER_IDENTITY="Developer ID Installer: <Your Name> (<TEAM_ID>)"
